{
  "name": "janaki-school-desktop",
  "version": "1.0.6",
  "description": "Janaki Secondary School \u2014 fee & school management (desktop)",
  "author": "Janaki Secondary School",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "np.edu.janaki.school",
    "productName": "Janaki School",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../server/assets",
        "to": "server/assets"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../server/prisma",
        "to": "server/prisma",
        "filter": [
          "**/*",
          "!seed-data/**",
          "!dev.db",
          "!*.db-journal",
          "!*.db-wal",
          "!import-data.ts",
          "!seed.ts"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!.bin/**",
          "!.cache/**",
          "!tsx/**",
          "!typescript/**",
          "!prisma/build/**",
          "!@prisma/engines/**",
          "!**/*.md",
          "!**/*.ts"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client/dist"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Janaki-School-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Janaki School"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mission-yadav",
        "repo": "School-management-System",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@22.3.27": true,
    "electron-builder@24.13.3": true,
    "app-builder-bin@4.0.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}