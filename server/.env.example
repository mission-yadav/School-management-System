# Copy to .env and fill in your Neon connection strings.

# Shared PostgreSQL database on Neon (https://neon.tech).
#   DATABASE_URL         -> the POOLED endpoint (host contains "-pooler"). Used by the app.
#   DIRECT_DATABASE_URL  -> the DIRECT endpoint (no "-pooler"). Used by prisma db push/migrate.
# Both must end with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/dbname?sslmode=require"

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth — use long random strings in production
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Seed admin (created on first run only if no admin exists)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
