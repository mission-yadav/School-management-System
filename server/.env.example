# Copy to .env and adjust for your machine.

# PostgreSQL connection (create the db first: `createdb sms_dev`)
DATABASE_URL="postgresql://USER@localhost:5432/sms_dev?schema=public"

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth — use long random strings in production
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Seed admin (created on first run if no admin exists)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
